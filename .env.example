# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_token_here
DISCORD_CLIENT_ID=your_client_id_here

# ── Optional ────────────────────────────────────────────────────────────────
# SQLite file path (default: bot.db in the project root)
DB_PATH=bot.db

# Tenor key for automatic GIF fetching
TENOR_API_KEY=

# TMDB key for /movie recommend (free: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Groq key (free: https://console.groq.com). Needed for persona replies in the
# server persona channel; without it /afk on explains why it can't run.
GROQ_API_KEY=
# Model used for persona replies
PERSONA_MODEL=openai/gpt-oss-120b

# Reddit (official API). Create a "script"/"web app" at https://www.reddit.com/prefs/apps
# and paste the id/secret. Without them the bot falls back to Reddit's public JSON,
# which Reddit may throttle or block.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:p-bot:1.0 (by /u/YOUR_REDDIT_USERNAME)

# Seconds of quiet in the DM before a running game's message is re-posted at the bottom (0 = off)
GAME_BUMP_DELAY=60

# Also register /hug, /kiss, ... as separate slash commands (default: false).
# /roleplay <action> already covers everything; Discord caps global commands at 100.
LEGACY_ROLEPLAY_COMMANDS=false

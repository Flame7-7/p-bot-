DISCORD_TOKEN=your_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Optional: Tenor API key for automatic GIF fetching
TENOR_API_KEY=

# Optional: TMDB (themoviedb.org) API key for /movie recommend.
# Free to generate at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Path for SQLite database file (default: bot.db in project root)
DB_PATH=bot.db

# Optional: Groq API key (free), needed for /afk on (AI auto-replies in
# your voice via /persona + /afk). Get one free at https://console.groq.com
GROQ_API_KEY=
